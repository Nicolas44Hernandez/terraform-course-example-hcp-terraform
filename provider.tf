terraform {
  cloud {

    organization = "NicolasHernandez"

    workspaces {
      name = "terraform-course-example-hcp-terraform"
    }
  }

  required_providers {
    random = {
      source  = "hashicorp/random"
      version = "~> 3.0"
    }

    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "eu-north-1"
}